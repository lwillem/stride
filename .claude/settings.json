{
  "permissions": {
    "allow": [
      "Bash(bash .claude/scripts/stride-test.sh *)",
      "Bash(make configure *)",
      "Bash(make all *)",
      "Bash(make install *)",
      "Bash(./bin/gtester *)",
      "Bash(nohup Rscript bin/rStride_gtester_covid19.R *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-intro.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-test-runs.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-state-of-play.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
